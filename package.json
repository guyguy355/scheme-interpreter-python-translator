{
  "name": "ppl",
  "version": "1.0.0",
  "description": "Code for \"Principles of Programming Languages\" course",
  "main": "index.js",
  "scripts": {
    "test": "mocha \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "build": "tsc --project tsconfig.json",
    "coverage": "nyc --reporter=html npm test",
    "demo:semantics-lab": "node -r ts-node/register ./semantics-lab.ts",
    "example:python": "node -r ts-node/register ./semantics-lab.ts --example python",
    "example:all": "node -r ts-node/register ./semantics-lab.ts --example all"
  },
  "keywords": [],
  "author": "Michael Elhadad",
  "license": "MIT",
  "dependencies": {
    "ramda": "^0.32.0",
    "s-expression": "^3.1.1"
  },
  "devDependencies": {
    "@types/chai": "^4.2.15",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.2.3",
    "@types/ramda": "^0.31.1",
    "chai": "^4.3.0",
    "mocha": "^11.7.5",
    "nyc": "^15.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
